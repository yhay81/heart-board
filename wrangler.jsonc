{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heart-board",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "heart-board.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["41 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heart-board",
      "database_id": "6dc829f3-56ae-44be-b504-c19306c9bdce",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
